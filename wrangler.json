{
	"name": "astro-blog-starter-template",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat",
		"disable_nodejs_process_v2"
	],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/admin",
			"/admin/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"ratelimits": [
		{
			"name": "ADMIN_LOGIN_LIMITER",
			"namespace_id": "2026101701",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}
