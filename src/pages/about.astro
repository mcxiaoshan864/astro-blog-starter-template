---
import { fade } from "astro:transitions";
import LinkIcon from "../components/LinkIcon.astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Guestbook from "../components/Guestbook.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={`关于我 · ${SITE_TITLE}`}
      description="我是 mcxiaoshan。这是我在互联网上留给自己的一小块空间。"
    />
  </head>
  <body>
    <Header />
    <main transition:name="page-content" transition:animate={fade({ duration: "0.28s" })} id="main" class="about">
      <div class="page-heading">
        <p class="eyebrow">A little about me</p>
        <h1
          data-en="Hello, nice to meet you."
          data-tw="你好，好開心喺度見到你。"
        >
          你好，很高兴遇见你。
        </h1>
        <p
          class="lead"
          data-en="I'm mcxiaoshan. Welcome to my little corner of the internet."
          data-tw="我係 mcxiaoshan，歡迎嚟我嘅個人小站。"
        >
          我是 mcxiaoshan，欢迎来到我的个人小站。
        </p>
      </div>
      <div class="about-body">
        <section>
          <span class="section-index">01 / ME</span>
          <div>
            <h2
              data-en="Curiosity comes first."
              data-tw="好多嘢，都係由好奇開始。"
            >
              好奇，是一个开始。
            </h2>
            <p
              data-en="I like exploring technology, trying things on my computer and phone, and figuring out how they work. Some attempts succeed; others leave me with a new question."
              data-tw="我鍾意研究科技，得閒會喺電腦同手機度試吓新嘢，睇吓佢哋點樣運作。有時一試就得，有時搞咗一輪，反而多咗條問題。"
            >
              我喜欢探索技术，也喜欢在电脑和手机上试些新东西，弄明白它们是怎么运作的。有些尝试很顺利，有些会留下一个新的问题。
            </p>
            <p
              data-en="I enjoy the process: an unfamiliar idea slowly making sense, or a small change making something feel better to use."
              data-tw="最有趣嘅，係本來唔明嘅嘢慢慢諗通咗，又或者只係改少少，就用得順手咗。呢啲小小嘅發現，已經夠開心。"
            >
              让我感到有趣的，是一个陌生的概念慢慢变得清晰，或是一个小小的改动，让日常使用多了一点顺手。
            </p>
          </div>
        </section>
        <section>
          <span class="section-index">02 / THIS SITE</span>
          <div>
            <h2
              data-en="A place to put things."
              data-tw="有啲諗法，想搵個地方擺低。"
            >
              给想法，一个落脚的地方。
            </h2>
            <p
              data-en="This site is a small space of my own. It can hold notes from an experiment, a thought from an ordinary day, or something I don't want to forget."
              data-tw="呢個網站，係我留畀自己嘅一個小天地。試過啲乜、平時諗到啲乜，又或者有啲唔想唔記得嘅小事，都可以喺度記低。"
            >
              这个网站，是我留给自己的一小块空间。它可以放下一次尝试的记录、一个普通日子里的念头，或是一件不想忘记的小事。
            </p>
            <p
              data-en="There is no fixed publishing schedule. I'll write when I have something to share, and let the rest grow slowly."
              data-tw="冇話幾時一定要更新。有嘢想分享就寫吓，其他嘢，慢慢嚟。"
            >
              不设定更新的期限。想写的时候就写一点，剩下的，慢慢来。
            </p>
          </div>
        </section>
        <section>
          <span class="section-index">03 / CONNECT</span>
          <div>
            <h2 data-en="See you elsewhere." data-tw="其他地方，都可以搵到我。">
              也可以，在别处遇见。
            </h2>
            <p
              data-en="Thanks for stopping by. You can also find me here:"
              data-tw="多謝你入嚟行吓。想再睇多啲，可以去呢幾度搵我："
            >
              谢谢你来逛逛。你也可以通过这些链接找到我：
            </p>
            <div class="contact-links">
              <a
                class="glass-control button"
                href="https://space.bilibili.com/3493093791763273"
                target="_blank"
                rel="noopener noreferrer"
              >
                <LinkIcon name="bilibili" />
                <span>Bilibili</span>
                <span aria-hidden="true">↗</span>
              </a>
              <a
                class="glass-control button"
                href="https://x.com/mcxiaoshan"
                target="_blank"
                rel="noopener noreferrer"
              >
                <LinkIcon name="x" />
                <span>X</span>
                <span aria-hidden="true">↗</span>
              </a>
              <a
                class="glass-control button"
                href="https://github.com/mcxiaoshan864"
                target="_blank"
                rel="noopener noreferrer"
              >
                <LinkIcon name="github" />
                <span>GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </section>
      </div>
      <Guestbook />
    </main>
    <Footer />
  </body>
</html>
<style>
  .about {
    max-width: 960px;
  }
  .page-heading {
    padding-bottom: 65px;
  }
  .page-heading h1 {
    font-size: clamp(2.3rem, 5.4vw, 4.1rem);
  }
  .page-heading .lead {
    font-size: 1.06rem;
  }
  .about-body {
    max-width: 800px;
  }
  .about-body section {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 30px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
  }
  .section-index {
    font-size: 0.6rem;
    letter-spacing: 0.13em;
    padding-top: 7px;
    color: var(--text-muted);
  }
  .about-body h2 {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .about-body p {
    font-size: 0.95rem;
    line-height: 2;
    color: var(--text-muted);
    margin-bottom: 17px;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }
  .contact-links .button {
    gap: 9px;
    font-size: 0.75rem;
    min-height: 44px;
    padding: 10px 22px;
  }
  @media (max-width: 700px) {
    .about-body section {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 28px 0;
    }
    .page-heading {
      padding-bottom: 35px;
    }
    .about-body h2 {
      font-size: 1.35rem;
    }
    .about-body p {
      font-size: 0.9rem;
    }
    .page-heading .lead {
      font-size: 0.9rem;
    }
  }
</style>
