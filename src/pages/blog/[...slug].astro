---
export const prerender = false;
import BlogPost from '../../layouts/BlogPost.astro';
import { publicEntry, renderMarkdown } from '../../server/journal';
let post;
try { post = await publicEntry(Astro.locals.runtime.env,Astro.params.slug || ''); }
catch { return new Response('日志暂时无法读取，请稍后重试。',{status:503,headers:{'Content-Type':'text/plain; charset=utf-8','Cache-Control':'no-store'}}); }
if (!post) return new Response('这篇日志不存在或尚未公开。',{status:404,headers:{'Content-Type':'text/plain; charset=utf-8','Cache-Control':'no-store'}});
Astro.response.headers.set('Cache-Control','no-store');
const html = renderMarkdown(post.content);
---

<BlogPost {...post.data}><div set:html={html} /></BlogPost>
