---
export const prerender=false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { validId,getEntry,emptyDraft,type Draft } from '../../../../server/journal';
if(!Astro.locals.adminSession)return Astro.redirect('/admin/login/',303);
const id=Astro.params.id || '';
if(!validId(id))return Astro.redirect('/admin/journal/',303);
let entry,unavailable=false;
try { entry=await getEntry(Astro.locals.runtime.env,id); }catch{unavailable=true;Astro.response.status=503;}
if(entry?.status==='trash')return Astro.redirect('/admin/journal/?filter=trash',303);
const draft=entry?JSON.parse(entry.draft) as Draft:emptyDraft();
const slug=entry?.slug || `note-${id.slice(0,8)}`;
---
<AdminLayout title={draft.title || '写一篇日志'} editor>
  <div class="topline"><a href="/admin/journal/">← 所有日志</a><span data-document-state>{entry?.status==='published'?'已发布 · 修改会先保存为草稿':'私密草稿'}</span></div>
  <p class="eyebrow">Make room for a thought</p>
  <div class="heading"><h1>慢慢写。</h1><p data-save-status role="status" aria-live="polite">{entry?'草稿已保存':'写下第一句话，草稿会自动保存。'}</p></div>
  {unavailable && <p class="notice error">文章暂时无法读取。请刷新后再编辑，避免覆盖已有内容。</p>}
  <div class="notice recovery" data-recovery hidden><p>发现这台设备上尚未同步的草稿。</p><button class="button glass-control" type="button" data-restore-local>恢复本地内容</button><button class="button glass-control" type="button" data-discard-local>使用服务器版本</button></div>
  <form data-journal-editor data-id={id} data-revision={entry?.revision||0} data-status={entry?.status||'draft'} data-slug-locked={!!entry?.first_published_at}>
    <fieldset disabled={unavailable}>
      <label class="sr-only" for="article-title">文章标题</label><input class="title-input" id="article-title" name="title" value={draft.title} maxlength="120" placeholder="给这篇日志起个名字" />
      <div class="metadata"><div><label for="article-author">作者</label><input id="article-author" name="author" value={draft.author} maxlength="80" /></div><div><label for="article-date">文章日期</label><input id="article-date" name="date" type="date" value={draft.date} required /></div></div>
      <label for="article-description">摘要 <span>选填，发布时可以自动生成</span></label><textarea id="article-description" name="description" rows="2" maxlength="300">{draft.description}</textarea>
      <details class="permalink"><summary>文章地址</summary><label for="article-slug">/blog/ 下的地址 <span>首次发布后固定，避免旧链接失效</span></label><input id="article-slug" name="slug" value={slug} maxlength="100" readonly={!!entry?.first_published_at} pattern="[a-z0-9]+(-[a-z0-9]+)*" /></details>
      <div class="writing-head"><label for="article-content">正文</label><div class="imports"><button class="button glass-control" type="button" data-import>导入文件 ↥</button><button class="button glass-control" type="button" data-image>插入图片 ＋</button></div></div>
      <input class="sr-only" tabindex="-1" type="file" data-document-file accept=".txt,.md,.doc,.docx" aria-label="选择导入文件" />
      <input class="sr-only" tabindex="-1" type="file" data-image-file accept="image/png,image/jpeg,image/gif,image/webp" aria-label="选择正文图片" />
      <div class="editor-modes" data-editor-modes role="group" aria-label="正文显示方式" hidden><button type="button" data-editor-mode="images" aria-pressed="true">图片直显</button><button type="button" data-editor-mode="markdown" aria-pressed="false">Markdown</button></div>
      <div class="toolbar" role="toolbar" aria-label="正文格式">
        <button type="button" data-format="bold" aria-label="加粗"><strong>B</strong></button><button type="button" data-format="italic" aria-label="斜体"><em>I</em></button><button type="button" data-format="heading" aria-label="二级标题">H₂</button><button type="button" data-format="list" aria-label="无序列表">列表</button><button type="button" data-format="quote" aria-label="引用">引用</button><button type="button" data-format="link" aria-label="链接">链接</button><button type="button" data-format="code" aria-label="代码块">代码</button>
      </div>
      <textarea class="content-input" id="article-content" name="content" rows="20" maxlength="360000" placeholder="写下今天想记住的事……&#10;&#10;可使用 Markdown，也可以用上方按钮添加格式。">{draft.content}</textarea>
      <div class="image-editor" data-image-editor hidden></div>
      <div class="writing-foot"><span>图片直接显示 · 可切换 Markdown 编辑链接</span><span data-word-count>0 字</span></div>
      <p class="hint">TXT 限 1 MB、DOC 限 2 MB、DOCX 限 8 MB。DOC 导入正文；DOCX 可保留常见格式和配图。</p>
      <p class="notice" data-import-result role="status" hidden></p>
      <div class="actions"><button class="button glass-control" type="button" data-save>保存草稿</button><button class="button glass-control" type="button" data-preview>预览 ↗</button><button class="button glass-control primary" type="button" data-publish>{entry?.status==='published'?'发布更新':'发布文章'}</button></div>
      <div class="secondary-actions"><button type="button" data-export>导出 Markdown</button><button type="button" data-unpublish hidden={entry?.status!=='published'}>撤回为草稿</button><button type="button" data-trash>移入回收站</button></div>
    </fieldset>
  </form>
  <p class="hint">自动保存仅更新草稿，点击“发布”才会改变访客看到的文章。</p>
  <noscript><p class="notice">请开启 JavaScript 后使用在线编辑器。</p></noscript>
  <script>import '../../../../scripts/journal-editor';</script>
</AdminLayout>
<style>
  a { text-decoration:none; }.topline { display:flex; justify-content:space-between; gap:20px; color:var(--text-muted); font-size:.75rem; margin-bottom:30px; }
  .heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin-bottom:20px; }.heading p { color:var(--text-muted); font-size:.7rem; text-align:right; max-width:450px; line-height:1.8; }
  fieldset { padding:0; margin:0; border:0; min-width:0; }
  .sr-only { position:absolute; width:1px!important; height:1px; min-height:0!important; padding:0!important; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0!important; }
  .title-input { border-radius:0!important; border:0!important; border-bottom:1px solid var(--line)!important; background:transparent!important; font-size:clamp(1.3rem,3vw,2rem)!important; padding:12px 0 20px!important; font-weight:500!important; line-height:1.5; }
  .metadata { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  label span { color:var(--text-muted); font-size:.65rem; margin-left:8px; }
  textarea { border-radius:22px!important; resize:vertical; line-height:1.8; }
  .permalink { margin-top:22px; }.permalink summary { font-size:.75rem; color:var(--text-muted); cursor:pointer; }.permalink input { font-size:.85rem; }
  .writing-head { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin:30px 0 14px; }.writing-head label { margin:0; }.imports { display:flex; gap:8px; flex-wrap:wrap; }.imports .button { min-height:40px; padding:9px 16px; font-size:.7rem; }
  .toolbar { display:flex; gap:3px; flex-wrap:wrap; padding:8px 10px; border:1px solid var(--line); border-radius:20px 20px 0 0; background:var(--glass); }
  .toolbar button { border:0; border-radius:999px; min-width:38px; min-height:36px; padding:6px 12px; background:transparent; color:var(--text-muted); font-size:.75rem; }.toolbar button:hover { background:var(--active); }
  .editor-modes { display:inline-flex; gap:4px; border:1px solid var(--line); border-radius:999px; padding:4px; margin-bottom:12px; background:var(--glass); }
  .editor-modes button { min-height:36px; padding:7px 15px; border:0; border-radius:999px; background:transparent; color:var(--text-muted); font-size:.7rem; white-space:nowrap; }
  .editor-modes button[aria-pressed="true"] { background:var(--active); color:var(--accent); box-shadow:inset 0 0 0 1px var(--line); }
  .image-editor { border:1px solid var(--line); border-top:0; border-radius:0 0 22px 22px; background:var(--glass); overflow:hidden; }
  .image-editor[aria-disabled="true"] { opacity:.65; }
  .image-editor :global(.cm-editor) { color:var(--text-main); min-height:440px; font:16px/1.95 ui-monospace,SFMono-Regular,Consolas,monospace; }
  .image-editor :global(.cm-editor.cm-focused) { outline:2px solid var(--accent); outline-offset:-2px; }
  .image-editor :global(.cm-scroller) { overflow-wrap:anywhere; font:inherit; }
  .image-editor :global(.cm-content) { padding:24px 0; caret-color:var(--text-main); }
  .image-editor :global(.cm-line) { padding:0 24px; }
  .image-editor :global(.cm-cursor) { border-left-color:var(--text-main); }
  .image-editor :global(.cm-placeholder) { color:var(--text-muted); }
  .image-editor :global(.cm-selectionBackground) { background:var(--active)!important; }
  .image-editor :global(.journal-inline-image) { display:block; margin:14px 24px 20px; padding:12px; border:1px solid var(--line); border-radius:20px; background:var(--glass); max-width:calc(100% - 48px); overflow:hidden; }
  .image-editor :global(.journal-inline-image img) { display:block; width:auto; max-width:100%; max-height:440px; height:auto; margin:0 auto; border-radius:12px; object-fit:contain; }
  .image-editor :global(.journal-inline-image figcaption) { color:var(--text-muted); font:12px/1.6 var(--font-body, sans-serif); text-align:center; overflow-wrap:anywhere; padding:10px 4px 0; }
  .image-editor :global(.image-unavailable figcaption) { padding:12px 4px; }
  .content-input { border-radius:0 0 22px 22px!important; border-top:0!important; padding:24px!important; min-height:440px; font:16px/1.95 ui-monospace,SFMono-Regular,Consolas,monospace!important; tab-size:2; }
  .writing-foot { display:flex; justify-content:space-between; gap:16px; font-size:.65rem; color:var(--text-muted); margin-top:12px; }
  .actions { display:flex; flex-wrap:wrap; gap:10px; margin:30px 0 20px; }.actions .button { font-size:.8rem; min-height:48px; }.primary { color:var(--accent); box-shadow:inset 0 0 0 1px var(--accent),var(--glass-shadow); margin-left:auto; }
  .secondary-actions { display:flex; flex-wrap:wrap; gap:20px; margin-top:24px; }.secondary-actions button { border:0; background:transparent; padding:6px 0; font-size:.72rem; color:var(--text-muted); }
  [hidden] { display:none!important; }.recovery .button { font-size:.7rem; margin:6px 8px 0 0; padding:8px 14px; min-height:38px; }
  @media(max-width:700px) { .topline { flex-direction:column; gap:10px; }.heading { align-items:flex-start; flex-direction:column; gap:0; }.heading p { text-align:left; }.metadata { grid-template-columns:1fr; gap:0; }.content-input { padding:18px!important; min-height:380px; }.image-editor :global(.cm-editor) { min-height:380px; }.image-editor :global(.cm-content) { padding:18px 0; }.image-editor :global(.cm-line) { padding-inline:18px; }.image-editor :global(.journal-inline-image) { margin-inline:12px; max-width:calc(100% - 24px); padding:8px; border-radius:16px; }.image-editor :global(.journal-inline-image img) { max-height:340px; }.actions { display:grid; grid-template-columns:1fr 1fr; }.primary { grid-column:1/-1; margin:0; }.writing-foot { font-size:.6rem; }.writing-foot span:first-child { max-width:70%; } }
</style>
