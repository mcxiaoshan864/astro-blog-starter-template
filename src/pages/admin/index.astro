---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
// Middleware authenticates before this page renders; keep an explicit guard as well.
const session = Astro.locals.adminSession;
if (!session) return Astro.redirect("/admin/login/", 303);
const expiry = new Intl.DateTimeFormat("zh-CN", { timeZone: "Asia/Shanghai", month: "long", day: "numeric", hour: "2-digit", minute: "2-digit", hour12: false }).format(session.exp * 1000);
---
<AdminLayout title="站长空间" wide>
  <p class="eyebrow">Behind the scenes</p>
  <div class="status"><span></span>已安全登录</div>
  <h1>你好，站长。</h1>
  <p class="intro">小站的另一面，留给你自己。</p>
  <dl>
    <div><dt>当前账户</dt><dd>admin</dd></div>
    <div><dt>身份</dt><dd>唯一管理员</dd></div>
    <div><dt>本次登录有效至</dt><dd>{expiry}（北京时间）</dd></div>
  </dl>
  <a class="button glass-control submit" href="/admin/guestbook/">留言管理 <span aria-hidden="true">↗</span></a>
  <p class="hint">查看待审核留言，公开、回复或删除。</p>
  <form method="POST" action="/admin/logout/">
    <button class="button glass-control submit" type="submit">退出登录 <span aria-hidden="true">↗</span></button>
  </form>
</AdminLayout>
<style>
  .status { display: inline-flex; gap: 8px; align-items: center; margin-bottom: 24px; font-size: .75rem; color: var(--text-muted); }
  .status span { width: 7px; height: 7px; border-radius: 50%; background: #42897a; }
  dl { margin: 30px 0; }
  dl div { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: .85rem; }
  dt { color: var(--text-muted); }
  dd { margin: 0; text-align: right; }
  @media (max-width: 450px) { dl div:last-child { flex-direction: column; gap: 6px; } dd { text-align: left; } }
</style>
