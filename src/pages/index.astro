---
import { fade } from "astro:transitions";
import LinkIcon from "../components/LinkIcon.astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main transition:name="page-content" transition:animate={fade({ duration: "0.28s" })} id="main" class="home">
      <div class="intro">
        <p class="eyebrow">A personal space on the internet</p>
        <h1>
          mcxiaoshan<span>.</span>
        </h1>
        <p
          class="headline"
          data-en="Curious about the world. At my own pace."
          data-tw="保持好奇，跟返自己嘅節奏。"
        >
          保持好奇，按自己的节奏。
        </p>
        <p
          class="description"
          data-en="A place for technology, everyday life, and whatever comes to mind."
          data-tw="講吓科技，記低日常，仲有間唔中諗到嘅嘢。"
        >
          关于技术，关于日常，也关于偶尔冒出来的想法。
        </p>
        <div class="actions">
          <a class="button glass-control" href="/about/">
            <span data-en="A little about me" data-tw="關於我">
              关于我
            </span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a
            href="/blog/"
            class="journal-link"
            data-en="Visit the journal ↗"
            data-tw="睇吓日誌 ↗"
          >
            去日志看看 ↗
          </a>
        </div>
      </div>
      <div class="elsewhere">
        <span
          class="elsewhere-label"
          data-en="ELSEWHERE"
          data-tw="其他地方都搵到我"
        >
          在别处
        </span>
        <div class="social-links">
          <a
            class="glass-control"
            href="https://space.bilibili.com/3493093791763273"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="platform-label">
              <LinkIcon name="bilibili" />
              Bilibili
            </span>
            <span aria-hidden="true">↗</span>
          </a>
          <a
            class="glass-control"
            href="https://x.com/mcxiaoshan"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="platform-label">
              <LinkIcon name="x" />X
            </span>
            <span aria-hidden="true">↗</span>
          </a>
          <a
            class="glass-control"
            href="https://github.com/mcxiaoshan864"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="platform-label">
              <LinkIcon name="github" />
              GitHub
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .home {
    min-height: calc(100svh - 183px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 95px;
    padding-bottom: 40px;
  }
  .intro {
    text-align: center;
    padding-bottom: 80px;
  }
  .intro .eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    margin-bottom: 32px;
    opacity: 0.85;
  }
  h1 {
    font-size: clamp(3.6rem, 9vw, 7.2rem);
    letter-spacing: -0.075em;
    line-height: 1.05;
    font-weight: 550;
    margin: 0 0 24px;
  }
  h1 span {
    color: #6489a4;
  }
  .headline {
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    letter-spacing: 0.08em;
    font-weight: 400;
    margin-bottom: 16px;
  }
  .description {
    font-size: 0.9rem;
    line-height: 1.9;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    margin-bottom: 0;
  }
  .actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    margin-top: 37px;
  }
  .actions svg {
    width: 20px;
    height: 20px;
  }
  .journal-link {
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .journal-link:hover {
    color: var(--text-main);
  }
  .elsewhere {
    text-align: center;
    margin-top: auto;
  }
  .elsewhere-label {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }
  .platform-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
  }
  .social-links a {
    min-width: 125px;
    padding: 11px 20px;
    border-radius: 99px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    text-decoration: none;
    font-size: 0.75rem;
  }
  .social-links a > span:last-child {
    opacity: 0.6;
  }
  @media (max-width: 700px) {
    .home {
      min-height: calc(100svh - 236px);
      padding-top: 60px;
      padding-bottom: 28px;
    }
    .intro {
      padding-bottom: 70px;
    }
    h1 {
      font-size: clamp(2.8rem, 10.5vw, 4.5rem);
      letter-spacing: -0.07em;
    }
    .intro .eyebrow {
      font-size: 0.48rem;
      letter-spacing: 0.2em;
      margin-bottom: 26px;
    }
    .headline {
      font-size: 1.04rem;
      letter-spacing: 0.025em;
    }
    .description {
      font-size: 0.76rem;
      max-width: 255px;
      margin: 0 auto;
    }
    .actions {
      gap: 22px;
      margin-top: 29px;
    }
    .actions .button {
      padding: 12px 22px;
      gap: 24px;
      font-size: 0.8rem;
      min-height: 48px;
    }
    .journal-link {
      font-size: 0.72rem;
    }
    .social-links {
      gap: 8px;
    }
    .social-links a {
      min-width: 0;
      gap: 10px;
      padding: 10px 13px;
      font-size: 0.7rem;
    }
    .social-links a > span:last-child {
      display: none;
    }
    .social-links :global(.link-icon) {
      width: 16px;
      height: 16px;
    }
    .elsewhere-label {
      font-size: 0.55rem;
    }
  }
</style>
