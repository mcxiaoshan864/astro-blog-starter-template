---
import { fade } from "astro:transitions";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
type Props = CollectionEntry<"blog">["data"];
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  author = "mcxiaoshan",
} = Astro.props;
const isAbout = Astro.url.pathname.replace(/\/$/, "") === "/about";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <meta name="author" content={author} />
  </head>
  <body>
    <Header />
    <main transition:name="page-content" transition:animate={fade({ duration: "0.28s" })} id="main" class="reading">
      <a class="back-link" href={isAbout ? "/" : "/blog/"}>
        ← {isAbout ? "返回首页" : "所有日志"}
      </a>
      <article class="glass">
        <div class="article-heading">
          <div class="eyebrow">
            {isAbout ? "Behind the screen" : "Notes & explorations"}
          </div>
          <h1>{title}</h1>
          <p class="article-description">{description}</p>
          <div class="article-meta">
            <span>{author}</span>
            <span>·</span>
            <FormattedDate date={pubDate} />
            {updatedDate && (
              <span>
                更新于 <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
        </div>
        {heroImage && (
          <img
            class="article-cover"
            src={heroImage}
            width="1024"
            height="512"
            alt=""
          />
        )}
        <div class="prose">
          <slot />
        </div>
        <div class="article-end">
          <span>✦</span> 感谢你读到这里。<a href="/blog/">继续探索 ↗</a>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
<style>
  .reading {
    max-width: 880px;
  }
  .back-link {
    display: inline-block;
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 24px;
    color: var(--text-muted);
  }
  article {
    border-radius: 32px;
    overflow: hidden;
  }
  .article-heading {
    padding: 44px 48px 30px;
  }
  .article-heading h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.4;
  }
  .article-description {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .article-meta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .article-cover {
    max-height: 420px;
    width: 100%;
    object-fit: cover;
  }
  .prose {
    padding: 36px 48px;
    overflow-wrap: anywhere;
    line-height: 1.95;
  }
  .prose :global(h1) {
    font-size: 1.7rem;
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: 40px;
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    margin-top: 32px;
  }
  .prose :global(li) {
    margin: 9px 0;
    padding-left: 5px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
  }
  .prose :global(img) {
    border-radius: 16px;
    margin: 24px auto;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 30px 0;
  }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .prose :global(td),
  .prose :global(th) {
    border: 1px solid var(--line);
    padding: 8px 12px;
  }
  .article-end {
    margin: 0 48px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .article-end > span {
    color: var(--accent);
  }
  .article-end a {
    margin-left: auto;
    text-decoration: none;
  }
  @media (max-width: 700px) {
    article {
      border-radius: 24px;
    }
    .article-heading {
      padding: 30px 24px;
    }
    .prose {
      padding: 24px;
      font-size: 0.95rem;
    }
    .article-end {
      margin: 0 24px;
      flex-wrap: wrap;
    }
    .article-heading h1 {
      font-size: 1.8rem;
    }
  }
</style>
