<section id="guestbook" class="guestbook" aria-labelledby="guestbook-heading" data-sitekey="0x4AAAAAAFZZjAgxARiD36E7">
  <div class="heading">
    <span class="section-index">04 / GUESTBOOK</span>
    <div>
      <h2 id="guestbook-heading" data-en="Leave a little hello." data-tw="嚟到，不如留句說話。">来过，就留句话吧。</h2>
      <p data-en="A thought, a question, or just a hello. I'm glad you stopped by." data-tw="分享吓諗法、問個問題，或者打聲招呼都得。多謝你嚟過。">分享一个想法，问个问题，或者打个招呼。谢谢你来过。</p>
    </div>
  </div>
  <div class="glass compose">
    <form data-guestbook-form>
      <div class="form-top"><span class="eyebrow">A note from you</span><span class="no-account" data-en="No account needed" data-tw="唔使註冊">无需注册</span></div>
      <label for="guest-name" data-en="Your name" data-tw="點稱呼你">怎么称呼你</label>
      <input id="guest-name" name="nickname" type="text" autocomplete="nickname" required maxlength="48" aria-describedby="guest-name-hint" />
      <span id="guest-name-hint" class="field-hint" data-en="Up to 24 characters" data-tw="最多 24 個字">最多 24 个字</span>
      <label for="guest-message" data-en="Your message" data-tw="想講啲乜">想说的话</label>
      <textarea id="guest-message" name="message" required rows="4" maxlength="2000" aria-describedby="guest-count"></textarea>
      <div class="counter" id="guest-count" aria-live="off">0 / 1000</div>
      <div class="verification" data-verification></div>
      <div class="form-bottom">
        <p class="moderation-note" data-en="Messages appear after review. Please don't share private information." data-tw="留言審核後先會公開，記住唔好放私人資料。">留言审核后公开，请勿填写隐私信息。</p>
        <button type="submit" class="button glass-control send" disabled><span data-en="Send a note" data-tw="送出留言">送出留言</span><svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="m5 12 14-7-5 14-3-6-6-1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m11 13 8-8" stroke="currentColor" stroke-width="1.5"/></svg></button>
      </div>
      <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      <noscript><p class="field-hint">开启 JavaScript 后即可查看和提交留言。</p></noscript>
    </form>
  </div>
  <div class="list-heading"><h3 data-en="Notes from visitors" data-tw="嚟訪嘅聲音">来访的声音</h3><span class="eyebrow">Little traces</span></div>
  <div data-message-list aria-busy="true"></div>
  <p data-list-status class="list-status" role="status" data-en="Loading messages…" data-tw="讀取緊留言…">正在读取留言…</p>
  <button data-load-more class="button glass-control load-more" type="button" hidden><span data-en="Earlier notes" data-tw="之前嘅留言">更早的留言</span><span aria-hidden="true">↓</span></button>
  <button data-retry class="button glass-control load-more" type="button" hidden><span data-en="Try again" data-tw="再試一次">重新读取</span><span aria-hidden="true">↻</span></button>
</section>
<script>
  import { installGuestbook } from '../scripts/guestbook';
  installGuestbook();
</script>
<style>
