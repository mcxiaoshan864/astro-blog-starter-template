---
import HeaderLink from "./HeaderLink.astro";
---

<a class="skip-link" href="#main">
  跳转到正文
</a>
<header class="site-header">
  <a class="wordmark" href="/">
    mcxiaoshan<span>.ccwu.cc</span>
  </a>
  <nav class="glass-control" aria-label="主导航">
    <HeaderLink href="/" data-nav="home">
      首页
    </HeaderLink>
    <HeaderLink href="/blog/" data-nav="blog">
      日志
    </HeaderLink>
    <HeaderLink href="/about/" data-nav="about">
      关于
    </HeaderLink>
  </nav>
  <div class="tools">
    <select id="language" aria-label="界面语言">
      <option value="zh-CN">简</option>
      <option value="zh-TW">繁</option>
      <option value="en">EN</option>
    </select>
    <button
      class="glass-control"
      id="theme-toggle"
      type="button"
      aria-label="切换深色模式"
      aria-pressed="false"
    >
      <svg
        class="moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M20.5 13a8.5 8.5 0 1 1-9.5-9.5A7 7 0 0 0 20.5 13Z" />
      </svg>
      <svg
        class="sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
      </svg>
    </button>
  </div>
</header>
<script is:inline>
  (() => {
    const words = {
      "zh-CN": { home: "首页", blog: "日志", about: "关于" },
      "zh-TW": { home: "首頁", blog: "日誌", about: "關於" },
      en: { home: "Home", blog: "Journal", about: "About" },
    };
    const select = document.getElementById("language");
    const update = (lang) => {
      if (!words[lang]) lang = "zh-CN";
      select.value = lang;
      document.documentElement.lang = lang === "zh-TW" ? "zh-HK" : lang;
      document
        .querySelectorAll("[data-nav]")
        .forEach((el) => (el.textContent = words[lang][el.dataset.nav]));
      window.dispatchEvent(new CustomEvent("lang-changed", { detail: lang }));
      try {
        localStorage.setItem("site-lang", lang);
      } catch {}
    };
    select.addEventListener("change", () => update(select.value));
    let lang = "zh-CN";
    try {
      lang = localStorage.getItem("site-lang") || lang;
    } catch {}
    update(lang);
  })();
</script>
<script>
  import { initThemeToggle } from "../scripts/theme-toggle";
  initThemeToggle();
</script>
<style>
  .site-header {
    width: min(1320px, calc(100% - 80px));
    margin: 30px auto 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    position: relative;
    z-index: 10;
  }
  .wordmark {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark span {
    font-weight: 400;
    opacity: 0.55;
  }
  nav {
    display: flex;
    gap: 5px;
    padding: 6px;
    border-radius: 99px;
  }
  nav :global(a) {
    display: block;
    min-width: 80px;
    padding: 10px 22px;
    border-radius: 99px;
    text-align: center;
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition:
      background 0.3s,
      color 0.3s;
  }
  nav :global(a.active) {
    background: var(--active);
    color: var(--text-main);
    box-shadow:
      inset 0 1px 1px #ffffff80,
      0 1px 4px #143a5a0d;
  }
  nav :global(a:hover) {
    color: var(--text-main);
    background: var(--active);
  }
  .tools {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .tools select {
    width: 43px;
    background: transparent;
    color: var(--text-muted);
    border: 0;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .tools option {
    background: var(--bg);
  }
  #theme-toggle {
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    color: var(--text-main);
  }
  svg {
    width: 19px;
    height: 19px;
  }
  .sun {
    display: none;
  }
  :global(html.dark) .sun {
    display: block;
  }
  :global(html.dark) .moon {
    display: none;
  }
  @media (max-width: 900px) {
    .wordmark span {
      display: none;
    }
    .site-header {
      width: calc(100% - 48px);
    }
    nav :global(a) {
      min-width: 66px;
      padding: 8px 16px;
    }
    .tools {
      gap: 8px;
    }
  }
  @media (max-width: 600px) {
    .site-header {
      grid-template-columns: 1fr auto;
      margin-top: 22px;
      gap: 25px;
    }
    nav {
      grid-column: 1/-1;
      grid-row: 2;
      justify-self: center;
    }
    nav :global(a) {
      min-width: 86px;
      padding: 10px 20px;
    }
    .tools {
      grid-column: 2;
      grid-row: 1;
    }
    #theme-toggle {
      width: 40px;
      height: 40px;
    }
  }
</style>
