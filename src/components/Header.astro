---
import HeaderLink from "./HeaderLink.astro";
---

<a class="skip-link" href="#main">
  跳转到正文
</a>
<header class="site-header">
  <nav class="glass" aria-label="主导航">
    <a href="/" class="brand" aria-label="mcxiaoshan 首页">
      <span class="brand-mark">
        m<span>✦</span>
      </span>
      <span>
        mcxiaoshan<span class="brand-sub">一个人的数字花园</span>
      </span>
    </a>
    <div class="internal-links">
      <HeaderLink href="/" data-nav="home">
        首页
      </HeaderLink>
      <HeaderLink href="/blog/" data-nav="blog">
        日志
      </HeaderLink>
      <HeaderLink href="/about/" data-nav="about">
        关于
      </HeaderLink>
    </div>
    <div class="tools">
      <select id="language" aria-label="界面语言">
        <option value="zh-CN">简中</option>
        <option value="zh-TW">繁中</option>
        <option value="en">EN</option>
      </select>
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换深色模式"
        aria-pressed="false"
      >
        <svg
          class="moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M20.5 13a8.5 8.5 0 1 1-9.5-9.5A7 7 0 0 0 20.5 13Z" />
        </svg>
        <svg
          class="sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
        </svg>
      </button>
    </div>
  </nav>
</header>
<script is:inline>
  (() => {
    const toggle = document.getElementById("theme-toggle");
    const syncTheme = () => {
      const dark = document.documentElement.classList.contains("dark");
      toggle.setAttribute("aria-pressed", String(dark));
      toggle.setAttribute("aria-label", dark ? "切换浅色模式" : "切换深色模式");
    };
    syncTheme();
    toggle.addEventListener("click", () => {
      document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem(
          "theme",
          document.documentElement.classList.contains("dark")
            ? "dark"
            : "light",
        );
      } catch {}
      syncTheme();
    });
    const dictionary = {
      "zh-CN": { home: "首页", blog: "日志", about: "关于" },
      "zh-TW": { home: "首頁", blog: "日誌", about: "關於" },
      en: { home: "Home", blog: "Journal", about: "About" },
    };
    const select = document.getElementById("language");
    const update = (lang) => {
      if (!dictionary[lang]) lang = "zh-CN";
      select.value = lang;
      document.documentElement.lang = lang;
      document
        .querySelectorAll("[data-nav]")
        .forEach((el) => (el.textContent = dictionary[lang][el.dataset.nav]));
      window.dispatchEvent(new CustomEvent("lang-changed", { detail: lang }));
      try {
        localStorage.setItem("site-lang", lang);
      } catch {}
    };
    select.addEventListener("change", () => update(select.value));
    let initial = "zh-CN";
    try {
      initial = localStorage.getItem("site-lang") || initial;
    } catch {}
    update(initial);
  })();
</script>
<style>
  .site-header {
    position: sticky;
    top: 18px;
    z-index: 100;
    width: min(1200px, calc(100% - 48px));
    margin: 22px auto 0;
  }
  .site-header nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    border-radius: 24px;
    gap: 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--text-main);
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
    line-height: 1.3;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    position: relative;
    width: 43px;
    height: 43px;
    border-radius: 15px;
    background: linear-gradient(145deg, #7584e4, #4a54ab);
    color: white;
    font-size: 28px;
    font-weight: 400;
    box-shadow:
      inset 0 1px 2px #fff9,
      0 4px 14px #5968bb33;
  }
  .brand-mark span {
    position: absolute;
    right: 3px;
    top: 3px;
    font-size: 12px;
  }
  .brand-sub {
    display: block;
    font-size: 10px;
    letter-spacing: 0.12em;
    font-weight: 400;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .internal-links {
    display: flex;
    gap: 4px;
    background: var(--soft);
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 99px;
  }
  .internal-links :global(a) {
    padding: 7px 20px;
    border-radius: 99px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .internal-links :global(a.active) {
    background: var(--card-bg);
    box-shadow:
      0 2px 6px #29385d12,
      inset 0 1px 0 #ffffff60;
    color: var(--text-main);
  }
  .tools {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .tools select {
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.78rem;
    max-width: 68px;
    cursor: pointer;
  }
  .tools option {
    background: var(--bg);
    color: var(--text-main);
  }
  #theme-toggle {
    display: grid;
    place-items: center;
    border: 1px solid var(--card-border);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    background: var(--soft);
    color: var(--text-main);
    cursor: pointer;
  }
  svg {
    width: 19px;
    height: 19px;
  }
  .sun {
    display: none;
  }
  :global(html.dark) .sun {
    display: block;
  }
  :global(html.dark) .moon {
    display: none;
  }
  @media (max-width: 700px) {
    .site-header {
      width: calc(100% - 24px);
      top: 10px;
      margin-top: 12px;
    }
    .site-header nav {
      flex-wrap: wrap;
      gap: 12px;
      padding: 12px;
    }
    .brand {
      font-size: 0.9rem;
    }
    .brand-sub {
      font-size: 9px;
    }
    .internal-links {
      order: 3;
      flex-basis: 100%;
      justify-content: center;
    }
    .internal-links :global(a) {
      padding: 6px 24px;
    }
    .tools {
      margin-left: auto;
      gap: 4px;
    }
  }
</style>
