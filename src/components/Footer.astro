---
const year = new Date().getFullYear();
---

<footer>
  <span>© {year} mcxiaoshan</span>
  <a href="/rss.xml">RSS ↗</a>
  <span class="site-note">随心记录，自由生长。</span>
</footer>
<script is:inline>
  // Highlights follow the pointer only while interacting; no permanent render loop.
  if (
    matchMedia("(hover: hover)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    document.querySelectorAll(".glass-control").forEach((el) => {
      el.addEventListener("pointermove", (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty(
          "--light-x",
          ((e.clientX - r.left) / r.width) * 100 + "%",
        );
        el.style.setProperty(
          "--light-y",
          ((e.clientY - r.top) / r.height) * 100 + "%",
        );
      });
      el.addEventListener("pointerleave", () => {
        el.style.removeProperty("--light-x");
        el.style.removeProperty("--light-y");
      });
    });
  }
</script>
<style>
  footer {
    width: min(1320px, calc(100% - 80px));
    margin: auto;
    display: flex;
    gap: 28px;
    align-items: center;
    padding: 30px 0;
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--text-muted);
  }
  footer a {
    text-decoration: none;
  }
  .site-note {
    margin-left: auto;
  }
  @media (max-width: 700px) {
    footer {
      width: calc(100% - 48px);
      gap: 18px;
      font-size: 0.6rem;
    }
  }
</style>
