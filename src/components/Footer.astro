---
const year = new Date().getFullYear();
---

<footer>
  <span>© {year} mcxiaoshan</span>
  <span
    class="site-note"
    data-en="A little at a time, at my own pace."
    data-tw="想寫就寫，慢慢嚟。"
  >
    随心记录，自由生长。
  </span>
</footer>
<style>
  footer {
    width: min(1320px, calc(100% - 80px));
    margin: auto;
    display: flex;
    gap: 28px;
    align-items: center;
    padding: 30px 0;
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: var(--text-muted);
  }
  .site-note {
    margin-left: auto;
  }
  @media (max-width: 700px) {
    footer {
      width: calc(100% - 48px);
      gap: 18px;
      font-size: 0.6rem;
    }
  }
</style>
