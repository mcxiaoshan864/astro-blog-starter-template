---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Wu Guohua. 保留所有权利。
	<div class="footer-links">
		<a href="/">大本营首页</a>
		<a href="/blog">赛博日志</a>
		<a href="/about">关于本站</a>
	</div>
</footer>

<style>
	footer {
		padding: 3rem 1.5rem;
		text-align: center;
		/* 继承 global.css 的文字颜色变量 */
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-top: 1rem;
	}
	.footer-links a {
		text-decoration: none;
		color: var(--text-muted);
		transition: color 0.2s ease;
	}
	.footer-links a:hover {
		color: var(--accent); /* 鼠标悬浮时亮起苹果蓝 */
	}
</style>
