---
import FormattedDate from "./FormattedDate.astro";
import type { PublicEntry } from '../server/journal';
interface Props {
  post: PublicEntry;
}
const { post } = Astro.props;
---

<a class="post-card glass" href={`/blog/${post.id}/`}>
  <div class="post-info">
    <div class="post-meta">
      <span class="tag">折腾手记</span>
      <FormattedDate date={post.data.pubDate} />
    </div>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <span class="read-more">
      阅读这篇日志 <span aria-hidden="true">↗</span>
    </span>
  </div>
</a>
