<script is:inline>
  (() => {
    const nodes = [...document.querySelectorAll("[data-en]")];
    const originals = nodes.map((el) => el.textContent);
    const update = (lang) =>
      nodes.forEach(
        (el, i) =>
          (el.textContent =
            lang === "en"
              ? el.dataset.en
              : lang === "zh-TW"
                ? el.dataset.tw || originals[i]
                : originals[i]),
      );
    window.addEventListener("lang-changed", (e) => update(e.detail));
    try {
      update(localStorage.getItem("site-lang"));
    } catch {}
  })();
</script>
